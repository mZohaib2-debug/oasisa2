# =============================================================================
# OasisA2 environment configuration — copy to .env and fill in.
# NEVER commit a real .env. Only names live here.
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
# Pooled connection used by the app at runtime.
#   local:  postgresql://oasisa2:oasisa2@localhost:5432/oasisa2?schema=public
#   Neon:   postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://oasisa2:oasisa2@localhost:5432/oasisa2?schema=public"
# Direct (non-pooled) connection used by Prisma Migrate. Local: same as above.
#   Neon:   postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require   (no -pooler)
DIRECT_DATABASE_URL="postgresql://oasisa2:oasisa2@localhost:5432/oasisa2?schema=public"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Stripe (payments) — architecture is ready; keys are placeholders -------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Clover POS integration — MOCKED until credentials exist ----------------
# CLOVER_ENVIRONMENT: "mock" | "sandbox" | "production"
CLOVER_ENVIRONMENT="mock"
CLOVER_CLIENT_ID=""
CLOVER_CLIENT_SECRET=""
CLOVER_MERCHANT_ID=""

# --- Web app ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# --- Admin app -----------------------------------------------------------
ADMIN_URL="http://localhost:3001"

# --- Mobile app (Expo) — public vars only ---------------------------------
EXPO_PUBLIC_API_URL="http://localhost:3000/api"

# --- Apple Sign In (placeholder) ----------------------------------------
APPLE_SIGN_IN_CLIENT_ID=""
APPLE_SIGN_IN_TEAM_ID=""
APPLE_SIGN_IN_KEY_ID=""
APPLE_SIGN_IN_PRIVATE_KEY=""

# --- Google Sign In (placeholder) -------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Push notifications (placeholder) ----------------------------------
EXPO_ACCESS_TOKEN=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
FCM_SERVER_KEY=""
